dist
out
node_modules
gamefiles
dfet
docs/.vitepress/cache
docs/.vitepress/dist
# scratch probes run from the repo root (dotted so they sort out of the way);
# they need to live here for module resolution, not in the history
/.*.ts

# compiled from `taoot/assets/nightdive.gif` by the `nightdive-movie` plugin in
# taoot/vite.config.ts, on the first dev server or build. Generated data, like dist/ —
# the GIF is the source that is tracked
/taoot/public/nightdive.mov

# the runner's PAT (tools/runner/compose.yml reads it as an env_file). A token
# that can register runners must never be committable, so this is a pattern
# rather than one name.
/tools/runner/*.secret

# stray capture from a backgrounded run
nohup.out

# scratch notes for the Skull Cracker disassembly work, deliberately local
assumptions.md

# `tsc -b` writes this beside the config it was pointed at; it is a build cache
# and says nothing a reader wants.
tsconfig.tsbuildinfo
*.tsbuildinfo


# `npm run coverage` (tools/coverage.mts): the raw data, the reports and the badge files
/coverage

# editor settings are each contributor's own
/.vscode/
__pycache__/

# the architecture map's data, read out of the code by tools/archmap.mts before
# every docs:dev and docs:build, so that the map is always the code it ships with
docs/.vitepress/theme/archmap/data.json
