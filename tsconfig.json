{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // the translations are JSON so a translator or a TMS can read them; the
    // per-language index.ts asserts each one against Catalogue (site/src/locales/)
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true
  },
  "include": ["engine", "site", "taoot", "dust", "tools"],
  // The rips live inside the game packages now, and a rip is not a source tree:
  // it is ~7,800 files of 1996 game data, and anything a probe happens to leave
  // in one is not part of this program.
  "exclude": ["**/gamefiles/**", "**/node_modules/**", "**/dist/**"]
}
