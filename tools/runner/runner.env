# The one place the runner's version is pinned. Sourced by both
# tools/setup-runner.sh (bare metal) and tools/runner/Dockerfile (container), so
# the two cannot drift apart.
#
# To bump: read the current version and its checksum straight from the API —
#
#   gh api repos/dhobi/dreamrefactory/actions/runners/downloads \
#     --jq '.[] | select(.os=="linux" and .architecture=="x64")
#                | {filename, sha256_checksum}'
#
# then rebuild the image. A runner more than a few versions behind is refused by
# GitHub, so this is not optional maintenance.
#
# There is a FLOOR as well as a ceiling: every `actions/*` step in the workflows
# runs on Node 24, and a node24 action needs runner **2.327.1 or newer**. Below
# that the self-hosted jobs fail at the first `actions/checkout`, not with a
# deprecation warning but with a hard error. Never pin under it.
RUNNER_VERSION=2.337.0
RUNNER_SHA256=70920811a4f8ad4328818682bca5c6469c1c942fab52448868071d0063816613

# Playwright's browsers come from the base image, so this tag MUST equal the
# version in package-lock.json — a mismatch means the suite drives a browser it
# was not recorded against. Check with:
#   node -p "require('./package-lock.json').packages['node_modules/playwright'].version"
PLAYWRIGHT_VERSION=1.61.1
