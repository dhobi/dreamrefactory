# A fresh container per job — the stronger of the two options in this directory.
#
# `docker run --rm` means the container is DESTROYED when its one job ends, and
# systemd starts a new one. Nothing at all is carried from one job to the next:
# not the workspace, not a stray process, not a modified file. compose.yml's
# `restart: always` cannot give you that, because restarting a container reuses
# its writable layer.
#
# Install:
#   docker build -f tools/runner/Dockerfile -t taoot-runner .
#   sudo install -m 600 -o root -g root tools/runner/runner.secret /etc/taoot-runner.env
#   sudo cp tools/runner/taoot-runner.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now taoot-runner
#
# Watch it:
#   journalctl -u taoot-runner -f
#
# /etc/taoot-runner.env holds one line, root-owned and 0600 so no other user on
# the box can read it:
#   GITHUB_PAT=github_pat_...

[Unit]
Description=GitHub Actions runner for taoot-web (ephemeral, one job per container)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
# The container exits 0 after each job; `always` is what makes that a loop
# rather than a stop. RestartSec keeps a crash-loop from hammering the API.
Restart=always
RestartSec=10s

# --rm is the whole point: no writable layer survives the job.
# --pull=never so a run never silently picks up a rebuilt image mid-flight;
#   rebuild deliberately, then `systemctl restart taoot-runner`.
ExecStart=/usr/bin/docker run --rm \
    --name taoot-runner \
    --pull=never \
    --env-file /etc/taoot-runner.env \
    --env TAOOT_GAMEFILES=/srv/taoot/gamefiles \
    --env RUNNER_LABELS=self-hosted,linux,x64,taoot-gamefiles \
    --volume /srv/taoot/gamefiles:/srv/taoot/gamefiles:ro \
    --security-opt no-new-privileges:true \
    --cap-drop ALL \
    --init \
    --memory 6g \
    --cpus 4 \
    --shm-size 1g \
    taoot-runner:latest

# Give a job in flight time to finish rather than killing it mid-assertion; the
# browser suite can legitimately run ~40 minutes.
TimeoutStopSec=60min
ExecStop=/usr/bin/docker stop --time 3600 taoot-runner

[Install]
WantedBy=multi-user.target
