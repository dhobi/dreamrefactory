# A fresh container per job — the stronger of the two options in this directory.
#
# `docker run --rm` means the container is DESTROYED when its one job ends, and
# systemd starts a new one. Nothing at all is carried from one job to the next:
# not the workspace, not a stray process, not a modified file. compose.yml's
# `restart: always` cannot give you that, because restarting a container reuses
# its writable layer.
#
# Install:
#   docker build -f tools/runner/Dockerfile -t dreamrefactory-runner .
#   sudo install -m 600 -o root -g root tools/runner/runner.secret /etc/dreamrefactory-runner.env
#   sudo cp tools/runner/dreamrefactory-runner.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now dreamrefactory-runner
#
# Watch it:
#   journalctl -u dreamrefactory-runner -f
#
# /etc/dreamrefactory-runner.env holds one line, root-owned and 0600 so no other
# user on the box can read it:
#   GITHUB_PAT=github_pat_...
#
# All four games' rip paths are declared below, but only Titanic's and Dust's are
# MOUNTED, because those are the two the workflows link. To add another, put its
# rip at the path its variable names and add the matching --volume line. Do not
# add the volume before the rip exists: ExecStart is not run through a shell, so
# a commented-out --volume is not a comment, and a bind mount of a path that is
# not there makes Docker create it empty.
#
# Renamed from `taoot-runner`. If you are upgrading an existing box, the old
# unit, image and env file are still there under the old names — stop and
# disable `taoot-runner` before enabling this one, or two runners answer for the
# same repository and jobs land on whichever won the race.

[Unit]
Description=GitHub Actions runner for dreamrefactory (ephemeral, one job per container)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
# The container exits 0 after each job; `always` is what makes that a loop
# rather than a stop. RestartSec keeps a crash-loop from hammering the API.
Restart=always
RestartSec=10s

# --rm is the whole point: no writable layer survives the job.
# --pull=never so a run never silently picks up a rebuilt image mid-flight;
#   rebuild deliberately, then `systemctl restart dreamrefactory-runner`.
ExecStart=/usr/bin/docker run --rm \
    --name dreamrefactory-runner \
    --pull=never \
    --env-file /etc/dreamrefactory-runner.env \
    --env TAOOT_GAMEFILES=/srv/taoot/gamefiles \
    --env DUST_GAMEFILES=/srv/dust/gamefiles \
    --env TIMELAPSE_GAMEFILES=/srv/timelapse/gamefiles \
    --env SKULLCRACKER_GAMEFILES=/srv/skullcracker/gamefiles \
    --env RUNNER_LABELS=self-hosted,linux,x64,dreamrefactory-gamefiles \
    --volume /srv/taoot/gamefiles:/srv/taoot/gamefiles:ro \
    --volume /srv/dust/gamefiles:/srv/dust/gamefiles:ro \
    --security-opt no-new-privileges:true \
    --cap-drop ALL \
    --init \
    --memory 6g \
    --cpus 4 \
    --shm-size 1g \
    dreamrefactory-runner:latest

# Give a job in flight time to finish rather than killing it mid-assertion; the
# browser suite can legitimately run ~40 minutes.
TimeoutStopSec=60min
ExecStop=/usr/bin/docker stop --time 3600 dreamrefactory-runner

[Install]
WantedBy=multi-user.target
