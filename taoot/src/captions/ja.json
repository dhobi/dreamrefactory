  "banks": {
    "zgossip1.sfx": {
      "z3.01": { "text": "ゼイテル問題が起きた", "who": "サシャ", "listened": true },
      "z3.02": { "text": "どんな問題だ？", "who": "ゼイテル", "listened": true },
      "z3.03": { "text": "ルバイヤートがあんたの指定した場所になかった", "who": "サシャ", "listened": true },
      "z3.04": { "text": "本当か？", "who": "ゼイテル", "listened": true },
      "z3.05": { "text": "ああ", "who": "サシャ", "listened": true },
      "z3.06": { "text": "だが、俺は自分で置いたんだぞ！どうなてるんだ？", "who": "ゼイテル", "listened": true },
      "z3.07": { "text": "私達に敵対する組織のエージェントがこの船に乗っている", "who": "サシャ", "listened": true },
      "z3.08": { "text": "どうして分かる？", "who": "ゼイテル", "listened": true },
      "z3.09": { "text": "私の部下が受け取りの場所で奴らをみたのだ", "who": "サシャ", "listened": true },
      "z3.10": { "text": "ルバイヤートはそいつらが持っているんだ", "who": "サシャ", "listened": true },
      "z3.11": { "text": "私のことがばれたら、私は破滅だ！", "who": "サシャ", "listened": true }
    },
    "zgossip2.sfx": {
      "z2.01": { "text": "あなたの言ったとおりに行った！ルバイヤートは手に入れた", "who": "サシャ", "listened": true },
      "z2.02": { "text": "私に感謝してくれよ", "who": "ゼイテル", "listened": true },
      "z2.03": { "text": "売買の金が入ったらな", "who": "サシャ", "listened": true },
      "z2.04": { "text": "本はどうする？", "who": "ゼイテル", "listened": true },
      "z2.05": { "text": "アメリカ人これくらーがいる。何も訊かずにいくらでも払う", "who": "サシャ", "listened": true },
      "z2.06": { "text": "だが、大佐問題が起きた", "who": "サシャ", "guess": true, "listened": true },
      "z2.07": { "text": "どんな問題だ？", "who": "ゼイテル", "listened": true },
      "z2.08": { "text": "私達に敵対する組織のエージェントがこの船に乗っている", "who": "サシャ", "listened": true },
      "z2.09": { "text": "どうして分かる？", "who": "ゼイテル", "listened": true },
      "z2.10": { "text": "私の部下が受け取りの場所で奴らをみたのだ", "who": "サシャ", "listened": true }
    },
    "zgossip3.sfx": {
      "z1.01": { "text": "注意するべきだ", "who": "ゼイテル", "guess": true, "listened": true },
      "z1.02": { "text": "絵はどうする？あんたの仲間が貨物室から持ってきたのか？", "who": "サシャ", "listened": true },
      "z1.03": { "text": "いや、まだ手に入れてない", "who": "ゼイテル", "listened": true },
      "z1.04": { "text": "だが、この手であそこに置いたぞ", "who": "サシャ", "listened": true },
      "z1.05": { "text": "サシャ落ち着け、お前ではない。裏切り者がいるのだ", "who": "ゼイテル", "listened": true },
      "z1.06": { "text": "あんたの仲間のハーデルリッツか？", "who": "サシャ", "listened": true },
      "z1.07": { "text": "もう仲間ではない。", "who": "ゼイテル", "listened": true },
      "z1.09": { "text": "ウイリーはインテリだ。スパイに必要な狡さを持っていない", "who": "ゼイテル", "listened": true },
      "z1.10": { "text": "あの絵と地図を取り返さねばならん。別の組織が持っているかも", "who": "ゼイテル", "listened": true },
      "z1.11": { "text": "ハーデルリッツはどうするんだ？", "who": "サシャ", "listened": true },
      "z1.12": { "text": "ハーデルリッツはこれ以上我が祖国に危害を加えることはない。", "who": "ゼイテル", "listened": true },
      "z1.13": { "text": "作戦を立てよう", "who": "ゼイテル", "listened": true }
    },
    "bedsit1.trk": {
      "door1": { "text": "こっそり出て行くつもりか？金を払え！", "who": "大家", "guess": true, "listened": true },
      "door2": { "text": "昔は大物だったそうだな。だが今は違う。ただの年寄りで金もない", "who": "大家", "guess": true, "listened": true },
      "door3": { "text": "いつ金を払うんだ？！いつだ？！", "who": "大家", "guess": true, "listened": true },
      "lady2": { "text": "やっと起きたか。家賃が二週間も遅れてるぞ", "who": "大家", "guess": true, "listened": true },
      "lady3": { "text": "戦争だろうが何だろうが、家賃を払わない奴は置いておけない", "who": "大家", "guess": true, "listened": true },
      "lady4": { "text": "今日中に払わなきゃ、外へ追い出すぞ。約束する！", "who": "大家", "guess": true, "listened": true }
    },
