  "tracks": {
    "bedrad1.trk": [
      { "from": 1.7, "to": 4.3, "text": "もう一度、本日の主なニュースをお伝えする", "who": "ラジオ", "guess": true, "listened": true },
      { "from": 5, "to": 8, "text": "ロンドンは今夜もドイツ軍の爆撃を受けた", "who": "ラジオ", "guess": true, "listened": true },
